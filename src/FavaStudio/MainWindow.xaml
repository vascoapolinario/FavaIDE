                                <Border Grid.Row="4" Grid.Column="2" Background="{StaticResource ControlDarkerBrush}" BorderBrush="{Binding CompilerRootStatusBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding CompilerRootStatusText}" Foreground="{Binding CompilerRootStatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Button Grid.Row="4" Grid.Column="3" Content="Browse" Command="{Binding BrowseCompilerRootCommand}" Margin="8,0,0,0" Padding="12,5"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="ANTLR jar" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AntlrJar, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                <Border Grid.Row="6" Grid.Column="2" Background="{StaticResource ControlDarkerBrush}" BorderBrush="{Binding AntlrStatusBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding AntlrStatusText}" Foreground="{Binding AntlrStatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Button Grid.Row="6" Grid.Column="3" Content="Browse" Command="{Binding BrowseAntlrJarCommand}" Margin="8,0,0,0" Padding="12,5"/>
