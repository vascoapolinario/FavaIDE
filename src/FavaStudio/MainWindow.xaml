                                    <TextBlock Text="Expected outputs" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseToolOutputsFolderCommand}" Margin="8,0,0,0" Padding="12,5"/>
                                        <TextBox Text="{Binding ToolOutputsFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                    </DockPanel>
