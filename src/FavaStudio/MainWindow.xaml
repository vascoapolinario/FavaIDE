                                                    <Border Width="34"
                                                            Height="34"
                                                            CornerRadius="6"
                                                            Background="{StaticResource FavaFileBadgeBrush}">
                                                        <TextBlock Text="F"
                                                                   Foreground="#1A1110"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
