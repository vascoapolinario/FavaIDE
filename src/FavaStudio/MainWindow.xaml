<Window x:Class="FavaStudio.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:FavaStudio.Models"
        xmlns:conv="clr-namespace:FavaStudio.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Fava Studio"
        Height="920"
        Width="1500"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonSurface" Property="Background" Value="#3A3D43"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonSurface" Property="Background" Value="#4D5663"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonSurface" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonSurface" Property="Background" Value="#A32014"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenQuickOpenCommand}"/>
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointAtCaretCommand}"/>
        <KeyBinding Key="F5" Command="{Binding StartDebugCommand}"/>
        <KeyBinding Key="F10" Command="{Binding DebugStepCommand}"/>
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopExecutionCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseQuickOpenCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding BackToEditorCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0,0,14,0"
                        Cursor="Hand">
                    <Border Background="{StaticResource ControlDarkerBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="4"
                                    Background="{StaticResource FavaFileBadgeBrush}"
                                    Margin="0,0,8,0">
                                <TextBlock Text="F"
                                           Foreground="#1A1110"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Fava Studio"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="#FF9A3D"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Menu Background="Transparent"
                      DockPanel.Dock="Left"
                      FontSize="14"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="Project">
                        <MenuItem Header="New Project" Command="{Binding CreateProjectCommand}"/>
                        <MenuItem Header="Open Project" Command="{Binding OpenProjectCommand}"/>
                        <MenuItem Header="Quick Open (Ctrl+P)" Command="{Binding OpenQuickOpenCommand}"/>
                        <Separator/>
                        <MenuItem Header="Recent Projects" ItemsSource="{Binding RecentProjects}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Recent Files" ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Close Project" Command="{Binding CloseProjectCommand}"/>
                        <MenuItem Header="Remove/Delete Project" Command="{Binding DeleteProjectCommand}"/>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Back to Editor" Command="{Binding BackToEditorCommand}"/>
                        <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}"/>
                        <MenuItem Header="Test Tool" Command="{Binding OpenToolsCommand}"/>
                        <MenuItem Header="VM Visualizer" Command="{Binding OpenVisualizerCommand}"/>
                        <MenuItem Header="Toggle Errors Panel" Command="{Binding ToggleDiagnosticsCommand}"/>
                    </MenuItem>
                    <MenuItem Header="Run">
                        <MenuItem Header="Run Current File" Command="{Binding RunCurrentCommand}"/>
                        <MenuItem Header="Stop Execution (Shift+F5)" Command="{Binding StopExecutionCommand}"/>
                        <Separator/>
                        <MenuItem Header="Start Debug (F5)" Command="{Binding StartDebugCommand}"/>
                        <MenuItem Header="Step (F10)" Command="{Binding DebugStepCommand}"/>
                        <MenuItem Header="Jump to Next Call" Command="{Binding DebugJumpToCallCommand}"/>
                        <MenuItem Header="Continue" Command="{Binding DebugContinueCommand}"/>
                        <MenuItem Header="Step Back" Command="{Binding DebugStepBackCommand}"/>
                        <Separator/>
                        <MenuItem Header="Toggle Breakpoint (F9)" Command="{Binding ToggleBreakpointAtCaretCommand}"/>
                    </MenuItem>
                </Menu>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RunCurrentCommand}"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Run current file"
                            Padding="16,5"
                            Margin="8,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Margin="0,0,7,0">
                                <Path Fill="White" Data="M 3 1 L 15 8 L 3 15 Z"/>
                            </Viewbox>
                            <TextBlock Text="Run" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartDebugCommand}"
                            ToolTip="Start debug session"
                            Padding="12,5"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Fill="{StaticResource TextMainBrush}" Data="M 5 1 H 11 V 4 H 14 V 8 H 16 V 11 H 14 V 15 H 11 V 17 H 5 V 15 H 2 V 11 H 0 V 8 H 2 V 4 H 5 Z M 5 6 H 11 V 4 H 5 Z M 5 12 V 15 H 11 V 12 Z"/>
                            </Viewbox>
                            <TextBlock Text="Debug"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopExecutionCommand}"
                            ToolTip="Stop running or debug execution"
                            Padding="12,5"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Margin="0,0,7,0">
                                <Path Fill="{StaticResource DangerBrush}" Data="M 2 2 H 14 V 14 H 2 Z"/>
                            </Viewbox>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveFileCommand}"
                            ToolTip="Save current file"
                            Padding="12,5"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Fill="{StaticResource TextMainBrush}" Data="M 2 1 H 14 L 17 4 V 17 H 2 Z M 5 2 V 7 H 13 V 2 Z M 5 12 V 16 H 14 V 12 Z"/>
                            </Viewbox>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleDiagnosticsCommand}"
                            ToolTip="Show or hide errors panel"
                            Padding="12,5"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Fill="{StaticResource TextMainBrush}" Data="M 8 1 L 16 15 H 0 Z M 7 6 H 9 V 10 H 7 Z M 7 12 H 9 V 14 H 7 Z"/>
                            </Viewbox>
                            <TextBlock Text="Errors"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenToolsCommand}"
                            ToolTip="Open test tools"
                            Padding="12,5"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Fill="{StaticResource TextMainBrush}" Data="M 5 1 H 13 V 3 H 10 V 15 H 13 V 17 H 5 V 15 H 8 V 3 H 5 Z M 1 4 H 5 V 6 H 3 V 12 H 5 V 14 H 1 Z M 13 4 H 17 V 14 H 13 V 12 H 15 V 6 H 13 Z"/>
                            </Viewbox>
                            <TextBlock Text="Tests"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenVisualizerCommand}"
                            ToolTip="Open visualizer"
                            Padding="12,5"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Fill="{StaticResource TextMainBrush}" Data="M 2 2 H 16 V 13 H 10 V 15 H 13 V 17 H 5 V 15 H 8 V 13 H 2 Z M 4 4 V 11 H 14 V 4 Z M 5 5 H 7 V 7 H 5 Z M 8 5 H 10 V 7 H 8 Z M 11 5 H 13 V 7 H 11 Z"/>
                            </Viewbox>
                            <TextBlock Text="VM"/>
                        </StackPanel>
                    </Button>
                    <Button Click="MinimizeWindow_OnClick"
                            ToolTip="Minimize"
                            Style="{StaticResource WindowControlButton}"
                            Width="38"
                            Height="30"
                            Margin="8,0,0,0">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Click="MaximizeWindow_OnClick"
                            ToolTip="Maximize or restore"
                            Style="{StaticResource WindowControlButton}"
                            Width="38"
                            Height="30">
                        <TextBlock Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Click="CloseWindow_OnClick"
                            ToolTip="Close"
                            Style="{StaticResource WindowCloseButton}"
                            Width="42"
                            Height="30">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="180"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.2*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="1.5*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Border DockPanel.Dock="Top"
                                    Padding="10,7"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="{StaticResource BgPanelAltBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Close"
                                                Command="{Binding CloseProjectCommand}"
                                                Padding="8,2"
                                                FontSize="11"
                                                Margin="0,0,4,0"/>
                                        <Button Content="Delete"
                                                Command="{Binding DeleteProjectCommand}"
                                                Padding="8,2"
                                                FontSize="11"
                                                Background="#3A1D1D"
                                                BorderBrush="#6A2A2A"
                                                Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="PROJECT"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border DockPanel.Dock="Top"
                                    Padding="10,6"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding CurrentProjectDirectory}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TreeView ItemsSource="{Binding ProjectTree}"
                                      SelectedItemChanged="ProjectTree_OnSelectedItemChanged"
                                      Margin="4,4,4,0"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type local:ProjectNode}" ItemsSource="{Binding Children}">
                                        <Grid Height="24" Margin="0,1" ToolTip="{Binding FullPath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ProjectTreeIcon"
                                                       Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding TreeIconBrush}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource TextMainBrush}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter TargetName="ProjectTreeIcon" Property="Text" Value="&#xE8B7;"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDirectory}" Value="True"/>
                                                    <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ProjectTreeIcon" Property="Text" Value="&#xE838;"/>
                                            </MultiDataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                                        <Setter Property="Tag"
                                                Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Add">
                                                        <MenuItem Header="New Folder"
                                                                  Command="{Binding NewDirectoryCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="New Fava File"
                                                                  Command="{Binding NewFavaFileCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="New Text File"
                                                                  Command="{Binding NewTextFileCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </MenuItem>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding DeleteNodeCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </DockPanel>

                        <GridSplitter Grid.Row="1"
                                      Height="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      Background="{StaticResource BorderBrush}"/>

                        <DockPanel Grid.Row="2">
                            <Border DockPanel.Dock="Top"
                                    Padding="10,7"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,1"
                                    Background="{StaticResource BgPanelAltBrush}">
                                <TextBlock Text="OUTLINE"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <ListBox x:Name="OutlineList"
                                     ItemsSource="{Binding OutlineItems}"
                                     MouseDoubleClick="OutlineList_OnMouseDoubleClick"
                                     Margin="4"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Border DockPanel.Dock="Left"
                                                    Width="30"
                                                    Height="20"
                                                    CornerRadius="4"
                                                    Background="{StaticResource ControlDarkerBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Badge}"
                                                           Foreground="{StaticResource AccentSoftBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMainBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Row="3"
                                      Height="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Rows"
                                      Background="{StaticResource BorderBrush}"/>

                        <DockPanel Grid.Row="4">
                            <Border DockPanel.Dock="Top"
                                    Padding="10,7"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,1"
                                    Background="{StaticResource BgPanelAltBrush}">
                                <DockPanel LastChildFill="False">
                                     <TextBlock DockPanel.Dock="Left"
                                                Text="TEST SUITE"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="New Test"
                                                Command="{Binding CreateTestPairCommand}"
                                                Padding="8,3"
                                                FontSize="12"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Run All"
                                                Command="{Binding RunAllTestsCommand}"
                                                Style="{StaticResource AccentButton}"
                                                Padding="8,3"
                                                FontSize="12"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Run Selected"
                                                Command="{Binding RunSelectedTestsCommand}"
                                                Padding="8,3"
                                                FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border DockPanel.Dock="Top"
                                    Padding="10,6"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Open Input"
                                                Command="{Binding OpenSelectedTestInputCommand}"
                                                Padding="8,3"
                                                FontSize="12"
                                                Margin="0,0,6,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TestSummary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMainBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource ControlDarkerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <TextBlock Text="{Binding TestTotalCount, StringFormat=Total {0}}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="#172B1D" BorderBrush="#2C663A" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <TextBlock Text="{Binding TestPassedCount, StringFormat=Passed {0}}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Column="4" Background="#351A1A" BorderBrush="#6A2A2A" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <TextBlock Text="{Binding TestFailedCount, StringFormat=Failed {0}}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Column="6" Background="{StaticResource ControlDarkerBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <TextBlock Text="{Binding TestPassPercentText}" Foreground="{StaticResource AccentSoftBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="5"
                                                 Value="{Binding TestPassPercent, Mode=OneWay}"
                                                 Margin="0,8,0,0"
                                                 Foreground="{StaticResource SuccessBrush}"
                                                 Background="{StaticResource ControlDarkerBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid>
                                     <ListBox ItemsSource="{Binding TestResults}"
                                              SelectedItem="{Binding SelectedTestResult}"
                                              Margin="4"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Foreground="{StaticResource TextMainBrush}"
                                              FontSize="13">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Right"
                                                                Text="{Binding Status}"
                                                                FontSize="12"
                                                                FontWeight="Bold"
                                                                Margin="8,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRun}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                        <Setter Property="Foreground" Value="#5AD18A"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasRun}" Value="True"/>
                                                                            <Condition Binding="{Binding Passed}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#FF6D6D"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding DurationText}"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Margin="0,0,8,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMainBrush}"/>
                                                        <TextBlock Text="{Binding Message}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding InputFileName}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="No tests found yet. Click 'New Test'."
                                               Margin="12,10,12,0"
                                               FontStyle="Italic"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestResults.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              Background="{StaticResource BorderBrush}"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="260" MinHeight="140"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BgPanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <DockPanel LastChildFill="True">
                            <!-- Debug toolbar (visible when IsDebugging=true) -->
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0">
                                <Button Content="Back"
                                        Command="{Binding DebugStepBackCommand}"
                                        ToolTip="Step Back"
                                        Visibility="{Binding IsDebugging, Converter={StaticResource BoolToVisibility}}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Margin="0,0,4,0"/>
                                <Button Content="Step"
                                        Command="{Binding DebugStepCommand}"
                                        ToolTip="Step one instruction (F10)"
                                        Style="{StaticResource AccentButton}"
                                        Visibility="{Binding IsDebugging, Converter={StaticResource BoolToVisibility}}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Margin="0,0,4,0"/>
                                <Button Content="Call"
                                        Command="{Binding DebugJumpToCallCommand}"
                                        ToolTip="Jump to next function call / return"
                                        Visibility="{Binding IsDebugging, Converter={StaticResource BoolToVisibility}}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Margin="0,0,4,0"/>
                                <Button Content="Continue"
                                        Command="{Binding DebugContinueCommand}"
                                        ToolTip="Run to next breakpoint or end"
                                        Visibility="{Binding IsDebugging, Converter={StaticResource BoolToVisibility}}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Margin="0,0,4,0"/>
                                <Button Content="Stop"
                                        Command="{Binding StopExecutionCommand}"
                                        ToolTip="Stop execution (Shift+F5)"
                                        Visibility="{Binding IsDebugging, Converter={StaticResource BoolToVisibility}}"
                                        Background="#4A1A1A"
                                        Foreground="IndianRed"
                                        BorderBrush="#6A2A2A"
                                        Padding="8,3"
                                        FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentFileName}"
                                           Foreground="{StaticResource TextMainBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Border Background="{StaticResource ControlDarkerBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,2"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="{Binding LastRunStatus}"
                                               Foreground="{Binding LastRunStatusBrush}"
                                               FontFamily="Consolas"
                                               FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource BgPanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TabControl x:Name="EditorTabs"
                                    ItemsSource="{Binding OpenEditorTabs}"
                                    SelectedItem="{Binding SelectedEditorTab}"
                                    Margin="0"
                                    FontSize="13"
                                    Background="{StaticResource TabStripBrush}"
                                    BorderThickness="0"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="EditorTabs_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="EditorTabs_OnPreviewMouseMove"
                                    Drop="EditorTabs_OnDrop"
                                    DragOver="EditorTabs_OnDragOver">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="MinWidth" Value="120"/>
                                    <Setter Property="Padding" Value="10,7"/>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="False" MinWidth="96" MaxWidth="230">
                                        <Border DockPanel.Dock="Left"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="4"
                                                Background="{Binding FileBadgeBrush}"
                                                Margin="0,0,7,0">
                                            <TextBlock Text="{Binding FileBadge}"
                                                       Foreground="{Binding FileBadgeTextBrush}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="*"
                                                       Foreground="{StaticResource AccentSoftBrush}"
                                                       FontWeight="Bold"
                                                       Margin="4,0,0,0"
                                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource TabCloseButton}"
                                                VerticalAlignment="Center"
                                                ToolTip="Close tab"
                                                Command="{Binding DataContext.CloseEditorTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Border Height="0" Visibility="Collapsed"/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition MinWidth="0">
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="300"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsRightPanelVisible, ElementName=RootWindow}" Value="False">
                                                <Setter Property="Width" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="EditorFindBar"
                                    Grid.Row="0"
                                    Visibility="Collapsed"
                                    Background="{StaticResource BgPanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource TabCloseButton}"
                                            ToolTip="Close"
                                            Click="CloseEditorFindBar_OnClick"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBox x:Name="FindBox"
                                                 Width="210"
                                                 Padding="8,5"
                                                 Margin="0,0,6,0"
                                                 ToolTip="Find"
                                                 TextChanged="FindBox_OnTextChanged"
                                                 KeyDown="FindBox_OnKeyDown"/>
                                        <TextBox x:Name="ReplaceBox"
                                                 Width="190"
                                                 Padding="8,5"
                                                 Margin="0,0,6,0"
                                                 ToolTip="Replace"
                                                 KeyDown="ReplaceBox_OnKeyDown"/>
                                        <Button Content="Next"
                                                Padding="10,5"
                                                Margin="0,0,4,0"
                                                Click="FindNext_OnClick"/>
                                        <Button Content="Prev"
                                                Padding="10,5"
                                                Margin="0,0,4,0"
                                                Click="FindPrevious_OnClick"/>
                                        <Button Content="Replace"
                                                Padding="10,5"
                                                Margin="0,0,4,0"
                                                Click="ReplaceOne_OnClick"/>
                                        <Button Content="All"
                                                Padding="10,5"
                                                Margin="0,0,10,0"
                                                Click="ReplaceAll_OnClick"/>
                                        <CheckBox x:Name="MatchCaseCheck"
                                                  Content="Aa"
                                                  Margin="0,0,10,0"
                                                  ToolTip="Match case"
                                                  Checked="SearchOption_OnChanged"
                                                  Unchecked="SearchOption_OnChanged"/>
                                        <CheckBox x:Name="WholeWordCheck"
                                                  Content="Word"
                                                  Margin="0,0,12,0"
                                                  ToolTip="Whole word"
                                                  Checked="SearchOption_OnChanged"
                                                  Unchecked="SearchOption_OnChanged"/>
                                        <TextBlock x:Name="SearchStatus"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBox x:Name="GoToLineBox"
                                                 Width="84"
                                                 Padding="8,5"
                                                 Margin="12,0,4,0"
                                                 ToolTip="Line"
                                                 KeyDown="GoToLineBox_OnKeyDown"/>
                                        <Button Content="Go"
                                                Padding="10,5"
                                                Margin="0"
                                                Click="GoToLine_OnClick"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <avalonedit:TextEditor Grid.Row="1"
                                                   x:Name="Editor"
                                                   FontFamily="Consolas"
                                                   FontSize="15"
                                                   ShowLineNumbers="True"
                                                   LineNumbersForeground="{StaticResource TextMutedBrush}"
                                                   Background="{StaticResource BgMainBrush}"
                                                   Foreground="{StaticResource TextMainBrush}">
                                <avalonedit:TextEditor.ContextMenu>
                                    <ContextMenu Opened="EditorContextMenu_OnOpened">
                                        <MenuItem x:Name="EditorContextCut" Header="Cut" Click="EditorContextCut_OnClick"/>
                                        <MenuItem x:Name="EditorContextCopy" Header="Copy" Click="EditorContextCopy_OnClick"/>
                                        <MenuItem x:Name="EditorContextPaste" Header="Paste" Click="EditorContextPaste_OnClick"/>
                                        <MenuItem x:Name="EditorContextDelete" Header="Delete" Click="EditorContextDelete_OnClick"/>
                                        <Separator/>
                                        <MenuItem Header="Select All" Click="EditorContextSelectAll_OnClick"/>
                                        <MenuItem Header="Find" Click="EditorContextFind_OnClick"/>
                                        <MenuItem Header="Replace" Click="EditorContextReplace_OnClick"/>
                                        <MenuItem Header="Go To Line" Click="EditorContextGoToLine_OnClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="EditorContextFormatSelection" Header="Format Selection Indent" Click="EditorContextFormatSelection_OnClick"/>
                                        <MenuItem Header="Format Document Indent" Click="EditorContextFormatDocument_OnClick"/>
                                        <MenuItem x:Name="EditorContextToggleComment" Header="Toggle Line Comment" Click="EditorContextToggleComment_OnClick"/>
                                        <MenuItem Header="Duplicate Line" Click="EditorContextDuplicateLine_OnClick"/>
                                        <MenuItem Header="Move Line Up" Click="EditorContextMoveLineUp_OnClick"/>
                                        <MenuItem Header="Move Line Down" Click="EditorContextMoveLineDown_OnClick"/>
                                        <Separator/>
                                        <MenuItem x:Name="EditorContextFindDeclaration" Header="Find Declaration" Click="EditorContextFindDeclaration_OnClick"/>
                                        <MenuItem x:Name="EditorContextFindReferences" Header="Find References" Click="EditorContextFindReferences_OnClick"/>
                                        <MenuItem x:Name="EditorContextQuickFix" Header="Quick Fix" Click="EditorContextQuickFix_OnClick"/>
                                        <Separator/>
                                        <MenuItem Header="Toggle Breakpoint" Click="EditorContextToggleBreakpoint_OnClick"/>
                                        <MenuItem Header="Save File" Click="EditorContextSaveFile_OnClick"/>
                                        <MenuItem Header="Run Current File" Click="EditorContextRunCurrentFile_OnClick"/>
                                    </ContextMenu>
                                </avalonedit:TextEditor.ContextMenu>
                            </avalonedit:TextEditor>
                        </Grid>

                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      Background="{StaticResource BorderBrush}"/>

                        <Border Grid.Column="2"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,0,0,0"
                                Visibility="{Binding ShowDiagnosticsPanel, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Padding="10,6"
                                        Background="{StaticResource BgPanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding DiagnosticsHeader}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <DockPanel DockPanel.Dock="Bottom"
                                           Height="230"
                                           Visibility="{Binding HasReferenceResults, Converter={StaticResource BoolToVisibility}}">
                                    <Border DockPanel.Dock="Top"
                                            Background="{StaticResource BgPanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,1"
                                            Padding="10,6">
                                        <TextBlock Text="{Binding ReferenceResultsHeader}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <ListBox x:Name="ReferencesList"
                                             ItemsSource="{Binding ReferenceResults}"
                                             MouseDoubleClick="ReferencesList_OnMouseDoubleClick"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             Margin="4,2">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,5"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Background="{StaticResource ControlDarkerBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="3,1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Badge}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                            <TextBlock Text="{Binding Preview}"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{StaticResource TextMainBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Location}"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Diagnostics}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         Margin="4,2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="⚠ " Foreground="Orange"/>
                                                <Run Text="{Binding Severity}" Foreground="Orange"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Line}" Foreground="{StaticResource TextMainBrush}"/>
                                                <Run Text=":"/>
                                                <Run Text="{Binding Column}" Foreground="{StaticResource TextMainBrush}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Message}" Foreground="{StaticResource TextMainBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- ── Debug Panel ─────────────────────────────────── -->
                        <Border Grid.Column="2"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,0,0,0"
                                Visibility="{Binding IsDebugging, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <!-- Header -->
                                <Border DockPanel.Dock="Top"
                                        Padding="10,6"
                                        Background="#2A1010"
                                        BorderBrush="#5A2222"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="🔴  DEBUG SESSION"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="IndianRed"/>
                                        <TextBlock Text="   • Click red gutter lane or press F9 to toggle breakpoint"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </DockPanel>
                                </Border>

                                <!-- Step status -->
                                <Border DockPanel.Dock="Top"
                                        Padding="10,5"
                                        Background="{StaticResource BgPanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding DebugStepStatus}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>

                                <!-- Current instruction -->
                                <Border DockPanel.Dock="Top"
                                        Padding="10,8"
                                        Background="{StaticResource BgPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT INSTRUCTION"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding DebugCurrentInstruction}"
                                                   FontFamily="Consolas"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#7BC1FF"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DebugCurrentNote}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stack heading -->
                                <Border DockPanel.Dock="Top"
                                        Padding="10,5"
                                        Background="{StaticResource BgPanelAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="STACK  (top → bottom)"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>

                                <!-- Empty stack hint -->
                                <TextBlock DockPanel.Dock="Top"
                                           Text="(stack is empty)"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Margin="12,8"
                                           Visibility="{Binding DebugStack.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DebugStack.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Stack pile -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="8,6">
                                    <ItemsControl ItemsSource="{Binding DebugStack}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2"
                                                        CornerRadius="4"
                                                        BorderThickness="1"
                                                        Padding="8,5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1A2535"/>
                                                            <Setter Property="BorderBrush" Value="#2A3A50"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                                    <Setter Property="Background" Value="#1A3528"/>
                                                                    <Setter Property="BorderBrush" Value="#2A5A3A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Top-of-stack arrow -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="▲ "
                                                                   Foreground="#5AD18A"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsTop, Converter={StaticResource BoolToVisibility}}"/>

                                                        <!-- Type label -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Type}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   Foreground="#7BC1FF"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Value -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Value}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E3C75F"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Row="3"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  Background="{StaticResource BorderBrush}"/>

                    <Border Grid.Row="4"
                            Background="#181A1F"
                            BorderBrush="#4A4F58"
                            BorderThickness="0,1,0,1"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#202226"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource ControlDarkerBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="{Binding LastRunDurationText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"/>
                                        </Border>
                                        <Border Background="{StaticResource ControlDarkerBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ConsoleLineCountText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"/>
                                        </Border>
                                        <CheckBox Content="VM only"
                                                  IsChecked="{Binding ShowOutputOnly}"
                                                  ToolTip="Show only VM output in the main console"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        <Button Command="{Binding CopyOutputCommand}"
                                                Padding="8,3"
                                                FontSize="12"
                                                Margin="0,0,4,0"
                                                ToolTip="Copy console output">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                    <Path Fill="{StaticResource TextMainBrush}" Data="M 5 1 H 15 V 11 H 13 V 3 H 5 Z M 2 4 H 12 V 16 H 2 Z M 4 6 V 14 H 10 V 6 Z"/>
                                                </Viewbox>
                                                <TextBlock Text="Copy"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ClearOutputCommand}"
                                                Padding="8,3"
                                                FontSize="12"
                                                Margin="0"
                                                ToolTip="Clear console output">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="11" Height="11" Margin="0,0,6,0">
                                                    <Path Fill="{StaticResource TextMainBrush}" Data="M 2 4 H 14 V 6 H 2 Z M 5 7 H 7 V 15 H 5 Z M 9 7 H 11 V 15 H 9 Z M 4 1 H 12 V 3 H 4 Z M 3 6 H 13 L 12 17 H 4 Z"/>
                                                </Viewbox>
                                                <TextBlock Text="Clear"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                            <Path Fill="{StaticResource AccentSoftBrush}" Data="M 1 3 H 17 V 15 H 1 Z M 3 5 V 13 H 15 V 5 Z M 4 6 L 8 9 L 4 12 V 10 L 6 9 L 4 8 Z M 9 11 H 13 V 12 H 9 Z"/>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OutputHeaderTitle}"
                                                       Foreground="{StaticResource TextMainBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LastRunStatus}"
                                                       Foreground="{Binding LastRunStatusBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TabControl Background="#181A1F"
                                        BorderThickness="0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem" BasedOn="{x:Null}">
                                        <Setter Property="MinWidth" Value="126"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="Background" Value="#22252B"/>
                                        <Setter Property="BorderBrush" Value="#30343B"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Border x:Name="TabSurface"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter ContentSource="Header"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              RecognizesAccessKey="True"
                                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                        </Border>
                                                        <Border x:Name="ActiveRail"
                                                                Height="2"
                                                                VerticalAlignment="Bottom"
                                                                Background="{StaticResource AccentSoftBrush}"
                                                                Opacity="0"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TabSurface" Property="Background" Value="#2A2E35"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#181A1F"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                                                            <Setter Property="BorderBrush" Value="#181A1F"/>
                                                            <Setter TargetName="ActiveRail" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>
                                <TabItem Header="Console">
                                    <Border x:Name="TerminalSurface"
                                            Background="#181A1F"
                                            MouseDown="TerminalSurface_OnMouseDown"
                                            PreviewTextInput="TerminalSurface_OnPreviewTextInput"
                                            PreviewKeyDown="TerminalSurface_OnPreviewKeyDown">
                                        <TextBox x:Name="VmOutputBox"
                                                 Text="{Binding VmOutput, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="False"
                                                 FontFamily="Consolas"
                                                 FontSize="15"
                                                 Background="#181A1F"
                                                 Foreground="{StaticResource TextMainBrush}"
                                                 BorderThickness="0"
                                                 Padding="18,16,18,22"
                                                 Cursor="IBeam"
                                                 CaretBrush="{StaticResource TextMainBrush}"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 VerticalScrollBarVisibility="Auto"
                                                 PreviewKeyDown="VmOutputBox_OnPreviewKeyDown"
                                                 PreviewTextInput="VmOutputBox_OnPreviewTextInput"/>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Constant Pool">
                                    <TextBox Text="{Binding ConstantPoolOutput, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Background="#181A1F"
                                             Foreground="{StaticResource TextMainBrush}"
                                             BorderThickness="0"
                                             Padding="14,12"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"/>
                                </TabItem>
                                <TabItem Header="Instructions">
                                    <TextBox Text="{Binding InstructionsOutput, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Background="#181A1F"
                                             Foreground="{StaticResource TextMainBrush}"
                                             BorderThickness="0"
                                             Padding="14,12"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"/>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsWelcomeViewVisible, Converter={StaticResource BoolToVisibility}}">
