                </Border>
            </Grid>
            <Grid Visibility="{Binding IsSettingsViewVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20" Background="{StaticResource BgMainBrush}">
                    <StackPanel MaxWidth="980">
                        <DockPanel Margin="0,0,0,20">
                            <Button DockPanel.Dock="Right" Content="Back to Editor" Command="{Binding BackToEditorCommand}" Padding="14,7" Margin="0"/>
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                                <TextBlock Text="Workspace, compiler, editor output, and test runner preferences." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                Margin="0,0,0,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#263821" BorderBrush="#3E6A34" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                    <TextBlock Text="{Binding CompilerStatusText}" Foreground="{Binding CompilerStatusBrush}" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding SettingsProjectName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                    <TextBlock Text="{Binding SettingsProjectPath}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                Margin="0,0,0,14"
                                Background="{StaticResource BgPanelBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Compiler" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Java executable" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource ControlDarkerBrush}" BorderBrush="{Binding JavaStatusBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding JavaStatusText}" Foreground="{Binding JavaStatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Button Grid.Row="2" Grid.Column="3" Content="Browse" Command="{Binding BrowseJavaPathCommand}" Margin="8,0,0,0" Padding="12,5"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Compiler root" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
