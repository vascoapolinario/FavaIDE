                                            <TextBlock Text="{Binding TestFoldersStatusText}" Foreground="{Binding TestFoldersStatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="Test Folders" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
