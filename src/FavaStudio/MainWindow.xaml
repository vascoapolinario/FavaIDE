                                                        <TextBlock Text="{Binding Details}"
                                                                   Foreground="{StaticResource AccentSoftBrush}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Open"
                                                                Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Path}"
                                                                Padding="10,4"
                                                                Margin="12,0,4,0"/>
                                                        <Button Content="Remove"
                                                                Command="{Binding DataContext.RemoveRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Path}"
                                                                ToolTip="Remove from recent projects"
                                                                Padding="10,4"
                                                                Margin="0,0,4,0"/>
                                                        <Button Command="{Binding DataContext.DeleteRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Path}"
                                                            ToolTip="Delete project folder and files"
